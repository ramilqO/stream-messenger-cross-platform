{
  "name": "stream-monorepo-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "shared/*",
    "core/*"
  ],
  "nohoist": [
      "**/react-native",
      "**/react-native/**",
      "**/@react-native/**",
      "**/@react-native"
    ],
    "scripts": {
    "postinstall": "node ./scripts/fix-android-hoisting.js"
  }
}
